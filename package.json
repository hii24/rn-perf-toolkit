{
  "name": "rn-perf-toolkit",
  "version": "0.5.0",
  "description": "React Native performance toolkit — profiler, memory leak detector, bundle analyzer, cold-start tracer",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rnperf": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "keywords": [
    "react-native",
    "performance",
    "profiler",
    "memory-leak",
    "bundle-analyzer",
    "cold-start",
    "hermes"
  ],
  "author": "Serhii Valko <valkoserhii@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "open": "^10.1.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "peerDependencies": {
    "react-native": ">=0.72.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
